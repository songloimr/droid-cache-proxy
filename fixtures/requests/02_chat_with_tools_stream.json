    },
    {
      "role": "user",
      "content": "Find all functions that parse config files in the project."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_code",
        "description": "Perform grep or AST code search across repository files",
        "parameters": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search pattern or query" },
            "path": { "type": "string", "description": "Optional subdirectory to restrict search" }
